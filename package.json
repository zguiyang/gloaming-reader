{
  "name": "gloaming",
  "version": "0.0.0",
  "private": true,
  "description": "Gloaming Reader — pnpm workspace root; live product is @gloaming/client",
  "type": "module",
  "license": "GPL-3.0-or-later OR Commercial",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "prettier": "./prettier.config.js",
  "scripts": {
    "dev": "pnpm --filter @gloaming/client dev",
    "dev:web": "pnpm --filter @gloaming/client dev",
    "dev:jobs": "pnpm --filter @gloaming/client dev:jobs",
    "build": "pnpm --filter @gloaming/client build",
    "build:jobs": "pnpm --filter @gloaming/client build:jobs",
    "lint": "pnpm --filter @gloaming/client lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @gloaming/client typecheck",
    "test": "echo \"No root tests; use pnpm --filter @gloaming/client test when added\"",
    "db:generate": "pnpm --filter @gloaming/client db:generate",
    "db:migrate": "pnpm --filter @gloaming/client db:migrate",
    "db:push": "pnpm --filter @gloaming/client exec drizzle-kit push --config server/db/drizzle.config.ts",
    "jobs": "pnpm --filter @gloaming/client jobs",
    "check:workers": "pnpm --filter @gloaming/client check:workers",
    "build:workers": "pnpm --filter @gloaming/client build:workers",
    "start:jobs": "pnpm --filter @gloaming/client start:jobs",
    "compose:init": "test -f docker-compose.yaml || cp docker-compose.yaml.example docker-compose.yaml",
    "prepare": "husky"
  },
  "lint-staged": {
    "{eslint.config.mjs,prettier.config.js,commitlint.config.js}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "client/**/*.{js,jsx,mjs,ts,tsx}": [
      "pnpm --filter @gloaming/client exec eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.7",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
