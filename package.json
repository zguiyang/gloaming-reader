{
  "name": "gloaming",
  "version": "0.1.0",
  "private": true,
  "description": "Gloaming Reader \u2014 AI-native English reading environment",
  "type": "module",
  "license": "GPL-3.0-or-later OR Commercial",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "prettier": "./prettier.config.js",
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No root tests yet\"",
    "db:generate": "drizzle-kit generate --config server/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config server/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config server/db/drizzle.config.ts",
    "dev:jobs": "tsx watch jobs/worker.ts",
    "jobs": "node --import tsx jobs/worker.ts",
    "build:jobs": "tsc -p tsconfig.jobs.json",
    "start:jobs": "node --import tsx jobs/worker.ts",
    "dev:worker": "pnpm run dev:jobs",
    "worker": "pnpm run jobs",
    "check:workers": "vinext check",
    "build:workers": "pnpm run build:vinext",
    "deploy:workers-preview": "vinext-cloudflare previews deploy --preview-name p4-v1-smoke",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "compose:init": "test -f docker-compose.yaml || cp docker-compose.yaml.example docker-compose.yaml",
    "prepare": "husky"
  },
  "lint-staged": {
    "prettier.config.js": [
      "prettier --write"
    ],
    "commitlint.config.js": [
      "prettier --write"
    ],
    "*.{js,jsx,mjs,ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.114",
    "@aws-sdk/client-s3": "^3.1112.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@vinext/cloudflare": "^1.3.4",
    "ai": "^7.0.169",
    "better-auth": "^1.6.26",
    "bullmq": "^6.1.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "entities": "^7.0.1",
    "fast-xml-parser": "^5.11.0",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.6.1",
    "lucide-react": "^1.72.0",
    "motion": "^12.38.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodewordfreq": "^0.2.1",
    "pg": "^8.22.0",
    "pino": "^9.9.0",
    "rate-limiter-flexible": "^11.2.0",
    "react": "19.3.1",
    "react-activity-calendar": "^3.2.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "recharts": "^3.10.1",
    "resend": "^4.8.0",
    "shadcn": "^4.23.0",
    "sharp": "0.34.5",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.10.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.14",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.19.7",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "babel-plugin-react-compiler": "1.0.0",
    "cf": "1.0.0-beta.29",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3",
    "vinext": "^1.4.5",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
