{
  "name": "@gloaming/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later OR Commercial",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js && node ./scripts/copy-prompts.mjs",
    "start": "node --import tsx dist/index.js",
    "worker": "node --import tsx dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm -w exec eslint apps/backend",
    "test": "vitest run",
    "seed:dev": "tsx scripts/seed-dev-works.ts",
    "reset:content": "tsx scripts/reset-content.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@gloaming/db": "workspace:*",
    "@gloaming/shared": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "@hono/zod-validator": "^0.7.2",
    "@langchain/core": "^1.2.6",
    "@langchain/openai": "^1.5.7",
    "better-auth": "^1.6.26",
    "bullmq": "^6.1.2",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.0",
    "hono": "^4.9.0",
    "hono-pino": "^0.10.2",
    "hono-rate-limiter": "^0.4.2",
    "ioredis": "^5.6.1",
    "langchain": "^1.5.6",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "nodewordfreq": "^0.2.1",
    "pg": "^8.22.0",
    "pino": "^9.9.0",
    "resend": "^4.8.0",
    "undici": "^8.10.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "@types/pg": "^8.15.5",
    "@types/yauzl": "^3.4.0",
    "jszip": "^3.10.1",
    "pino-pretty": "^13.1.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
