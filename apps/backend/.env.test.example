# Backend test environment — copy to `.env.test` (gitignored alongside `.env`).
# Vitest loads this file via tests/setup.ts; DATABASE_URL is overridden from TEST_DATABASE_URL.
# Missing keys may still be filled from `.env` (setup loads `.env` then `.env.test`).

# Dedicated PostgreSQL database (NOT gloaming_backend)
TEST_DATABASE_URL=postgresql://root:root@127.0.0.1:5433/gloaming_test

# Shared with dev — copy values from `.env` if you run functional tests locally
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6380
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Gloaming
LLM_CONFIG_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32

# Required by the same Zod schema as API/Worker (no NODE_ENV exception).
# Prefer real test/sandbox credentials, or copy from local `.env`.
RESEND_API_KEY=re_test_or_copy_from_dotenv
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=test-bucket
S3_ACCESS_KEY_ID=test-access-key
S3_SECRET_ACCESS_KEY=test-secret-key
S3_FORCE_PATH_STYLE=false
