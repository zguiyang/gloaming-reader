# Boot validates env via Zod automatically (API and Worker import `env` at module load).
# Node
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# Public web origin (CORS, Better Auth baseURL via Next /api proxy, email links)
FRONTEND_URL=http://localhost:3000

# Better Auth (secret ≥ 16 chars)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Postgres — Compose host 5433 → container 5432 (local development only)
DATABASE_URL=postgresql://root:root@127.0.0.1:5433/gloaming_backend

# Automated tests use a separate database — copy `.env.test.example` → `.env.test`
# TEST_DATABASE_URL=postgresql://root:root@127.0.0.1:5433/gloaming_test

# Redis — Compose host 6380 → container 6379
REDIS_URL=redis://127.0.0.1:6380

# Mail (Resend) — required at boot for API and Worker
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Gloaming

# AES-256 key for LLM API keys in DB (32 bytes, base64 or 64-char hex)
# Generate: openssl rand -base64 32
LLM_CONFIG_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32

# Object storage (S3-compatible).
# Optional for AWS S3; required by providers such as R2 or MinIO.
S3_ENDPOINT=https://your-s3-endpoint.example.com
S3_REGION=auto
S3_BUCKET=your_bucket_name
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_FORCE_PATH_STYLE=false
