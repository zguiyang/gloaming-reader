# Worker-only runtime configuration.
# Copy production values from Dokploy secrets; never commit real values.
NODE_ENV=production
LOG_LEVEL=info
GLOAMING_SERVICE=worker

# PostgreSQL and Redis must resolve from the shared Docker network.
DATABASE_URL=postgresql://user:password@postgres-host:5432/database
REDIS_URL=redis://:password@redis-host:6379

# Must match the API value so Worker jobs can decrypt stored LLM credentials.
# Generate: openssl rand -base64 32
LLM_CONFIG_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32

# S3-compatible object storage.
# Optional for AWS S3; required by providers such as R2 or MinIO.
S3_ENDPOINT=https://your-s3-endpoint.example.com
S3_REGION=auto
S3_BUCKET=your_bucket_name
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_FORCE_PATH_STYLE=false
