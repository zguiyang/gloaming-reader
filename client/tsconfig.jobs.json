  "include": ["jobs/**/*.ts", "server/**/*.ts", "lib/**/*.ts", "shared/**/*.ts", "i18n/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts", ".next"]
}
