# Production application stack for Dokploy (or any Docker Compose host).
# Copy to Dokploy "Compose" source or reference this path in your project.
#
# NOT included: PostgreSQL and Redis — use existing external services and set
# DATABASE_URL / REDIS_URL on `api` and `worker` via Dokploy environment/secrets.
#
# Public routing: attach Dokploy Domain only to `web`. Do not publish a public
# domain for `api`; Next rewrites /api/* to the internal `api` service.

services:
  web:
    build:
      context: .
      dockerfile: apps/web/Dockerfile
      args:
        API_INTERNAL_URL: http://api:3333
    restart: unless-stopped
    environment:
      NODE_ENV: production
      # Required at runtime for Next /api rewrites (see apps/web/proxy.ts).
      API_INTERNAL_URL: http://api:3333
      # Set in Dokploy to the public https origin, e.g. https://read.example.com
      # NEXT_PUBLIC_APP_URL: https://read.example.com
    depends_on:
      api:
        condition: service_healthy
    expose:
      - '3000'

  api:
    build:
      context: .
      dockerfile: apps/backend/Dockerfile
    command: ['node', '--import', 'tsx', 'dist/index.js']
    restart: unless-stopped
    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      PORT: 3333
      # Inject via Dokploy (names only — never commit values):
      # FRONTEND_URL, BETTER_AUTH_SECRET, DATABASE_URL, REDIS_URL,
      # RESEND_API_KEY, MAIL_FROM_ADDRESS, MAIL_FROM_NAME,
      # LLM_CONFIG_ENCRYPTION_KEY, S3_* (see apps/backend/.env.example)
    expose:
      - '3333'
    healthcheck:
      test:
        [
          'CMD',
          'node',
          '-e',
          "fetch('http://127.0.0.1:3333/api/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))",
        ]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 40s

  worker:
    build:
      context: .
      dockerfile: apps/backend/Dockerfile
    command: ['node', '--import', 'tsx', 'dist/worker.js']
    restart: unless-stopped
    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      PORT: 3333
      # Same backend secrets as `api` (shared image, BullMQ consumer).
    depends_on:
      api:
        condition: service_healthy
