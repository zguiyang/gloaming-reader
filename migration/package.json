{
  "name": "gloaming-migration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @gloaming/client dev",
    "build": "pnpm --filter @gloaming/client build",
    "lint": "pnpm --filter @gloaming/client lint",
    "typecheck": "pnpm --filter @gloaming/client typecheck",
    "dev:jobs": "pnpm --filter @gloaming/client dev:jobs",
    "jobs": "pnpm --filter @gloaming/client jobs",
    "build:jobs": "pnpm --filter @gloaming/client build:jobs",
    "start:jobs": "pnpm --filter @gloaming/client start:jobs"
  },
  "workspaces": [
    "client",
    "packages/*",
    "vendor/*"
  ],
  "dependencies": {
    "iconv-lite": "workspace:*"
  },
  "overrides": {
    "iconv-lite": "workspace:*"
  }
}
