# Gloaming — Next (UI + Route Handlers) and same-package worker
# Do not set NODE_ENV here — Next sets production for `next build`; a development
# value in .env breaks /_global-error prerender (react resolves to null).
LOG_LEVEL=info

# Public origin (Better Auth baseURL, email links). Next dev default:
# Prefer matching the host you type in the browser (localhost vs 127.0.0.1).
# Auth also trusts the localhost↔127.0.0.1 swap and ports 3000/3001 in local dev.
FRONTEND_URL=http://localhost:3000

BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Optional first admin bootstrap (create:admin when ported)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-use-at-least-8-characters

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Postgres — Compose host 5433 → container 5432
DATABASE_URL=postgresql://root:root@127.0.0.1:5433/gloaming_backend

# Redis — Compose host 6380 → container 6379
REDIS_URL=redis://127.0.0.1:6380

RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Gloaming

# openssl rand -base64 32
LLM_CONFIG_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32

S3_ENDPOINT=https://your-s3-endpoint.example.com
S3_REGION=auto
S3_BUCKET=your_bucket_name
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_FORCE_PATH_STYLE=false
